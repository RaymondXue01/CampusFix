<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorOnBackground"
    tools:context=".view.IssueCreation">

    <TextView
        android:id="@+id/Header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Issue Creation"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:background="?attr/colorPrimary"
        android:textColor="?attr/colorSecondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorTertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_bar"
        app:labelVisibilityMode="labeled"/>

    <!-- Creating layout for issue creation functionality-->
    <View
        android:id="@+id/create_issue_background"
        android:layout_height="500dp"
        android:layout_width="380dp"
        android:layout_margin="32dp"
        android:foregroundGravity="center"
        android:background="@drawable/rounded_shape"
        android:backgroundTint="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title: Text -->
    <TextView
        android:id="@+id/create_issue_background_title"
        android:layout_width="255dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintTop_toTopOf="@id/create_issue_background"
        app:layout_constraintStart_toStartOf="@id/create_issue_background"

        android:text="Title:"
        android:textStyle="bold"
        android:textColor="?attr/colorSecondary"
        android:textSize="20sp"
        android:paddingBottom="5dp"/>
    <EditText
        android:id="@+id/create_issue_title"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:background="@drawable/rounded_shape"
        android:backgroundTint="?attr/colorAccent"
        android:textColor="?attr/colorSecondary"
        android:padding="5dp"

        app:layout_constraintStart_toStartOf="@id/create_issue_background"
        app:layout_constraintTop_toBottomOf="@id/create_issue_background_title" />

    <!-- Category: Dropdown -->
    <TextView
        android:id="@+id/create_issue_background_category"
        android:layout_width="255dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="8dp"
        android:textColor="?attr/colorSecondary"
        app:layout_constraintTop_toBottomOf="@id/create_issue_title"
        app:layout_constraintStart_toStartOf="@id/create_issue_background"

        android:text="Category:"
        android:textStyle="bold"
        android:textSize="20sp"
        android:paddingBottom="5dp"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/create_issue_category"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        app:endIconMode="dropdown_menu"

        app:layout_constraintTop_toBottomOf="@id/create_issue_background_category"
        app:layout_constraintStart_toStartOf="@id/create_issue_background" >

        <AutoCompleteTextView
            android:id="@+id/create_issue_category_dropdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_shape"
            android:backgroundTint="?attr/colorAccent"
            android:textColor="?attr/colorSecondary"
            android:layout_weight="1"
            android:inputType="none"
            android:hint="Select Category Level"
            android:textSize="19dp"
            android:paddingLeft="5dp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Priority: Dropdown -->
    <TextView
        android:id="@+id/create_issue_background_priority"
        android:layout_width="255dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintTop_toBottomOf="@id/create_issue_category"
        app:layout_constraintStart_toStartOf="@id/create_issue_background"

        android:text="Priority:"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="?attr/colorSecondary"
        android:paddingBottom="5dp"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/create_issue_priority"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        app:endIconMode="dropdown_menu"

        app:layout_constraintTop_toBottomOf="@id/create_issue_background_priority"
        app:layout_constraintStart_toStartOf="@id/create_issue_background" >

        <AutoCompleteTextView
            android:id="@+id/create_issue_priority_dropdown"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_shape"
            android:backgroundTint="?attr/colorAccent"
            android:textColor="?attr/colorSecondary"
            android:layout_weight="1"
            android:inputType="none"
            android:hint="Select Priority Level"
            android:textSize="19dp"
            android:paddingLeft="5dp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Location: Text -->
    <TextView
        android:id="@+id/create_issue_background_location"
        android:layout_width="255dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintTop_toBottomOf="@id/create_issue_priority"
        app:layout_constraintStart_toStartOf="@id/create_issue_background"

        android:text="Location:"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="?attr/colorSecondary"
        android:paddingBottom="5dp"/>
    <EditText
        android:id="@+id/create_issue_location"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:background="@drawable/rounded_shape"
        android:backgroundTint="?attr/colorAccent"
        android:textColor="?attr/colorSecondary"
        android:padding="5dp"

        app:layout_constraintTop_toBottomOf="@id/create_issue_background_location"
        app:layout_constraintStart_toStartOf="@id/create_issue_background" />

    <!-- Description: Text -->
    <TextView
        android:id="@+id/create_issue_background_description"
        android:layout_width="255dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintTop_toBottomOf="@id/create_issue_location"
        app:layout_constraintStart_toStartOf="@id/create_issue_background"

        android:text="Description:"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="?attr/colorSecondary"
        android:paddingBottom="5dp"/>
    <EditText
        android:id="@+id/create_issue_description"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:background="@drawable/rounded_shape"
        android:backgroundTint="?attr/colorAccent"
        android:textColor="?attr/colorSecondary"
        android:padding="5dp"

        app:layout_constraintTop_toBottomOf="@id/create_issue_background_description"
        app:layout_constraintStart_toStartOf="@id/create_issue_background" />

    <!-- Button -->
    <Button
        android:id="@+id/create_issue_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="?attr/colorAccent"
        android:layout_marginBottom="10dp"

        android:focusable="true"
        android:clickable="true"
        android:text="Create Issue"
        android:textColor="?attr/colorSecondary"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/create_issue_background" />


</androidx.constraintlayout.widget.ConstraintLayout>