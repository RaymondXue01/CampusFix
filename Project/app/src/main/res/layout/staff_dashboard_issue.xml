<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/design_default_color_secondary"
    app:strokeWidth="1dp" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="?attr/colorOnBackground">

        <!-- Top Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorPrimary">

            <TextView
                android:id="@+id/staff_issue_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="Issue Title Here"
                android:layout_weight="2"
                android:layout_margin="10dp"
                android:textSize="12sp"
                android:textColor="?attr/colorSecondary"
                android:ellipsize="end" />

            <EditText
                android:id="@+id/staff_assigned_staff_input"
                android:layout_width="00dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginHorizontal="4dp"
                android:hint="No Staff Assigned"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="2"
                android:gravity="center_horizontal" >

                <TextView
                    android:id="@+id/staff_issue_status_static"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status goes here"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/staff_issue_status"
                    android:layout_width="match_parent"
                    android:layout_height="32dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginVertical="6dp"
            android:background="#CCCCCC" />
        <!-- Staff Notes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorOnBackground">

            <TextView
                android:id="@+id/staff_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notes: "
                android:textSize="13sp"
                android:layout_marginEnd="5dp" />

            <EditText
                android:id="@+id/staff_note_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Enter Staff Note"
                android:textSize="12sp"
                android:maxLines="2" />

            <Button
                android:id="@+id/update_issue_individual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:backgroundTint="?attr/colorAccent"
                android:text="Update"
                android:textColor="?attr/colorSecondary"
                android:textSize="12sp"
                android:paddingHorizontal="10dp"/>


        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
