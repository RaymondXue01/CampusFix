<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".view.ProfileScreen">

    <data>
        <variable
            name="viewModel"
            type="com.example.testingapp.viewmodel.ProfileViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorOnBackground">

        <!-- Header -->
        <TextView
            android:id="@+id/profile_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp"
            android:background="?attr/colorPrimary"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Profile Info Card -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:padding="20dp"
            android:background="?attr/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/profile_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/user_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Information"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingBottom="12dp"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textViewNameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintTop_toBottomOf="@id/user_info_title"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textViewNameValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.userName}"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/user_info_title"
                app:layout_constraintStart_toEndOf="@id/textViewNameLabel"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/textViewEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintTop_toBottomOf="@id/textViewNameLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/textViewEmailValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.userEmail}"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/textViewNameLabel"
                app:layout_constraintStart_toEndOf="@id/textViewEmailLabel"
                android:layout_marginTop="12dp"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/textViewRoleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Role: "
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintTop_toBottomOf="@id/textViewEmailLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/textViewRoleValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.userRole}"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/design_default_color_primary"
                app:layout_constraintTop_toBottomOf="@id/textViewEmailLabel"
                app:layout_constraintStart_toEndOf="@id/textViewRoleLabel"
                android:layout_marginTop="12dp"
                android:layout_marginStart="8dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Change theme dropdown & button -->
        <TextView
            android:id="@+id/change_theme"
            android:layout_width="255dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="8dp"
            app:layout_constraintTop_toBottomOf="@id/profile_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            android:text="Theme Settings"
            android:gravity="center"
            android:padding="5dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorSecondary"
            android:paddingBottom="5dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/theme_settings"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="5dp"

            app:endIconMode="dropdown_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/change_theme">

            <AutoCompleteTextView
                android:id="@+id/theme_dropdown"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rounded_shape"
                android:backgroundTint="?attr/colorAccent"
                android:hint="Select Theme"
                android:textColorHint="?attr/colorSecondary"
                android:inputType="none"
                android:paddingLeft="5dp"
                android:textSize="15dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Theme Button -->
        <Button
            android:id="@+id/save_theme_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:padding="10dp"
            android:backgroundTint="?attr/colorAccent"
            android:text="Save Theme"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/theme_settings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Logout Text -->
        <TextView
            android:id="@+id/logout_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Press below to logout and return to the start screen"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="?attr/colorSecondaryVariant"
            app:layout_constraintTop_toBottomOf="@id/save_theme_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/logout_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:padding="16dp"
            android:backgroundTint="?attr/colorAccent"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/logout_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorTertiary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/bottom_nav_bar"
            app:labelVisibilityMode="labeled"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>