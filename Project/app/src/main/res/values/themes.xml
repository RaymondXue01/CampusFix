<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TestingApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorOnBackground">@color/default_background</item>
        <item name="colorPrimary">@color/default_primary</item>
        <item name="colorSecondary">@color/default_secondary</item>
        <item name="colorAccent">@color/default_accent</item>
        <item name="colorTertiary">@color/default_tertiary</item>
    </style>

    <!-- Dark Application Theme -->
    <style name="Theme.App.Dark" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnBackground">@color/dark_background</item>
        <item name="colorPrimary">@color/dark_primary</item>
        <item name="colorSecondary">@color/dark_secondary</item>
        <item name="colorAccent">@color/dark_accent</item>
        <item name="colorTertiary">@color/dark_tertiary</item>
    </style>

    <!-- Green Application Theme -->
    <style name="Theme.App.Green" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnBackground">@color/green_background</item>
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorSecondary">@color/green_secondary</item>
        <item name="colorAccent">@color/green_accent</item>
        <item name="colorTertiary">@color/green_tertiary</item>
    </style>

    <!-- Blue Application Theme -->
    <style name="Theme.App.Blue" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnBackground">@color/blue_background</item>
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorSecondary">@color/blue_secondary</item>
        <item name="colorAccent">@color/blue_accent</item>
        <item name="colorTertiary">@color/blue_tertiary</item>
    </style>

    <style name="Theme.TestingApp" parent="Base.Theme.TestingApp" />

    <!-- Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="colorPrimary">@color/default_primary</item>
        <item name="colorOnBackground">@color/default_background</item>
        <item name="colorSecondary">@color/default_secondary</item>
        <item name="colorAccent">@color/default_accent</item>

        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <item name ="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name ="windowSplashScreenIconBackgroundColor">#4A148C</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.TestingApp</item>
    </style>

</resources>